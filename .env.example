# ---- Database (Neon) ----
# Pooled host (-pooler) — used by the running API.
DATABASE_URL=Host=ep-xxxx-pooler.region.aws.neon.tech;Port=5432;Database=neondb;Username=neondb_owner;Password=;SSL Mode=Require;No Reset On Close=true;Maximum Pool Size=20
# Direct host — used ONLY for `dotnet ef database update` and migration jobs.
DATABASE_URL_DIRECT=Host=ep-xxxx.region.aws.neon.tech;Port=5432;Database=neondb;Username=neondb_owner;Password=;SSL Mode=Require
# Local fallback (docker compose up postgres):
# DATABASE_URL=Host=localhost;Port=5432;Database=woodlounge;Username=woodlounge;Password=woodlounge;SSL Mode=Disable

# ---- Auth (JWT) ----
JWT_SIGNING_KEY=replace-with-a-long-random-secret-at-least-32-chars
JWT_ISSUER=wood-lounge-api
JWT_AUDIENCE=wood-lounge-web
# Comma-separated web origins allowed by CORS
ALLOWED_ORIGINS=http://localhost:3000

# ---- Paystack ----
PAYSTACK_MODE=fake
PAYSTACK_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
PAYSTACK_PUBLIC_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
PAYSTACK_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ---- Object storage (S3-compatible; Cloudflare R2 preferred) ----
STORAGE_ENDPOINT=https://xxxxxxxxxxxx.r2.cloudflarestorage.com
STORAGE_BUCKET=wood-lounge
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
STORAGE_PUBLIC_BASE_URL=https://cdn.example.com

# ---- Notifications (dev implementations log; real adapters are stubs) ----
SMS_PROVIDER=termii
SMS_API_KEY=
EMAIL_PROVIDER=stub
EMAIL_API_KEY=
WHATSAPP_PROVIDER=stub
WHATSAPP_TOKEN=

# ---- Google OAuth ----
GOOGLE_CLIENT_ID=xxxxxxxxxxxx.apps.googleusercontent.com

# ---- Seed ----
SEED_ADMIN_EMAIL=admin@woodlounge.test
SEED_ADMIN_PASSWORD=change-me-in-dev-only
